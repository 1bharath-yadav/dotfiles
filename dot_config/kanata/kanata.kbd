;; Kanata Power-User Configuration for Arch Linux / Hyprland
;; Home-Row Mods + Navigation Layer + System/Symbol/App Layers + Hyprkan
;; Note: All physical keys (Super, Numbers, Arrows, F-keys) retain default behavior.

(defcfg
  process-unmapped-keys yes
  log-layer-changes no
  concurrent-tap-hold yes
)

(defvar
  tap-time 200
  hold-time 180
  chord-time 50
)

(defsrc
  esc    f1   f2   f3   f4   f5   f6   f7   f8   f9   f10  f11  f12
  grv    1    2    3    4    5    6    7    8    9    0    -    =    bspc
  tab    q    w    e    r    t    y    u    i    o    p    [    ]    \
  caps   a    s    d    f    g    h    j    k    l    ;    '    ret
  lsft   z    x    c    v    b    n    m    ,    .    /    up   rsft
  fn     lctl lalt lmet          spc         rmet ralt left down rght
)

(defalias
  ;; Home-Row Mods (Left Hand)
  a (tap-hold-release $tap-time $hold-time a lmet)
  s (tap-hold-release $tap-time $hold-time s lalt)
  d (tap-hold-release $tap-time $hold-time d lctl)
  f (tap-hold-release $tap-time $hold-time f lsft)

  ;; Home-Row Mods (Right Hand)
  j (tap-hold-release $tap-time $hold-time j rsft)
  k (tap-hold-release $tap-time $hold-time k rctl)
  l (tap-hold-release $tap-time $hold-time l ralt)
  sem (tap-hold-release $tap-time $hold-time ; rmet)

  ;; CapsLock -> Tap Escape, Hold Control / Nav
  cap (tap-hold-release $tap-time $hold-time esc lctl)

  ;; Spacebar -> Tap Space, Hold Nav Layer
  spc (tap-hold-release $tap-time $hold-time spc (layer-toggle nav))

  ;; System Control Shortcuts
  vold vold
  volu volu
  prev prev
  next next
  pp   pp
  brdn brdn
  brup brup
  scolor S-M-c

  ;; App Launcher Signals (Caught by Hyprland/Hyprkan)
  akitty S-C-A-M-k
  achrom S-C-A-M-c
  abrave S-C-A-M-b
  avival M-A-e
  adisco S-C-A-M-d
  anotes M-A-o
  acalen C-M-c
  aspoti S-C-A-M-s
  afindr M-e
  asystm S-C-A-M-a
  adavin S-C-A-M-v
  amword S-C-A-M-w
  aexcel S-C-A-M-x
  arecut S-C-A-M-r
  ateams S-C-A-M-t
  ayoutu S-C-A-M-y
  awhats S-C-A-M-h
  asocia S-C-A-M-g
  a--obs S-C-A-M-o
  a1pass S-C-A-M-p
  aforkl S-C-A-M-f
  audemy S-C-A-M-u
  asetap S-C-A-M-i
  awinap S-C-A-M-n
  a-zoom S-C-A-M-z
  aprevw S-C-A-M-q
  aneovd M-c
  a-mail C-M-m
  achatg S-C-A-M-e

  ;; Browser Action Aliases (Hyprkan Context)
  b-back A-left
  b-fwd  A-right
  b-ntab C-tab
  b-ptab C-S-tab
  b-new  C-t
  b-cls  C-w
  b-rld  C-r
  b-reop C-S-t
  b-url  C-l
  b-bmrk C-d
)

(defchordsv2
  (w e r) C-= $chord-time first-release ()
  (s d f) C-- $chord-time first-release ()
  (q w e) volu $chord-time first-release ()
  (a s d) vold $chord-time first-release ()
  (spc j k) - $chord-time first-release ()
  (spc j l) S-- $chord-time first-release ()
  (spc u i) ` $chord-time first-release ()
  (spc u o) S-` $chord-time first-release ()
  (spc m ,) = $chord-time first-release ()
  (spc m .) S-= $chord-time first-release ()
  (spc f g) A-tab $chord-time first-release ()
  (spc s c) S-C-A-M-l $chord-time first-release ()
  (spc caps) caps $chord-time first-release ()
)

;; 1. MAIN LAYER (Default Typing Layer with Home-Row Mods)
(deflayer main
  esc    f1   f2   f3   f4   f5   f6   f7   f8   f9   f10  f11  f12
  grv    1    2    3    4    5    6    7    8    9    0    -    =    bspc
  tab    q    w    e    r    t    y    u    i    o    p    [    ]    \
  @cap   @a   @s   @d   @f   g    h    @j   @k   @l   @sem '    ret
  lsft   z    x    c    v    b    n    m    ,    .    /    up   rsft
  fn     lctl lalt lmet          @spc        rmet ralt left down rght
)

;; 2. NAVIGATION LAYER (Hold Spacebar)
(deflayer nav
  lrld   f1   f2   f3   f4   f5   f6   f7   f8   f9   f10  f11  f12
  grv    1    2    3    4    5    6    7    8    9    0    -    =    del
  tab    _    _    _    _    _    _    home pgdn pgup end  _    _    _
  @cap   @a   @s   @d   @f   _    left down up   rght _    _    ret
  lsft   _    _    _    _    _    _    _    _    _    _    up   rsft
  fn     lctl lalt lmet          _           rmet ralt left down rght
)

;; 3. SYMBOL & NUMBER LAYER
(deflayer symb
  esc    f1   f2   f3   f4   f5   f6   f7   f8   f9   f10  f11  f12
  grv    S-1  S-2  S-3  S-4  S-5  S-6  S-7  S-8  S-9  S-0  -    =    bspc
  tab    1    2    3    4    5    6    7    8    9    0    [    ]    \
  caps   @a   @s   @d   @f   _    _    @j   @k   @l   @sem '    ret
  lsft   z    x    c    v    b    [    S-[  S-]  ]    /    up   rsft
  fn     lctl lalt lmet          bspc        rmet ralt left down rght
)

;; 4. SYSTEM CONTROL LAYER
(deflayer syst
  esc    f1   f2   f3   f4   f5   f6   f7   f8   f9   f10  f11  f12
  grv    1    2    3    4    5    6    7    8    9    0    -    =    bspc
  tab    _    _    _    _    _    prev vold volu next pp   _    _    _
  caps   @a   @s   @d   @f   _    _    @j   @k   @l   @sem '    ret
  lsft   _    _    @scolor brdn brup _ _    _    _    _    up   rsft
  fn     lctl lalt lmet          lrld        rmet ralt left down rght
)

;; 5. APPS LAUNCHER LAYER
(deflayer apps
  esc    f1   f2   f3   f4   f5   f6   f7   f8   f9   f10  f11  f12
  grv    1    2    3    4    5    6    7    8    9    0    -    =    bspc
  tab   @adavin @amword @aexcel @arecut @ateams @ayoutu @awhats @asocia @a--obs @a1pass [ ] \
  caps  @afindr _    @adisco @aforkl @achrom @aspoti @akitty @abrave _    @achatg @asystm ret
  lsft  @a-zoom @anotes @acalen @aprevw @avival @aneovd @a-mail @awinap _ _ up rsft
  fn     lctl lalt lmet          spc         rmet ralt left down rght
)

;; 6. BROWSER LAYER (HYPRKAN CONTEXT-AWARE)
(deflayer browser
  esc    f1   f2   f3   f4   f5   f6   f7   f8   f9   f10  f11  f12
  grv    1    2    3    4    5    6    7    8    9    0    -    =    bspc
  tab    q    @b-cls _  @b-rld @b-new _  @b-reop @b-url @b-bmrk p [ ] \
  @cap   @a   @s   @d   @f   g    @b-back @b-ntab @b-ptab @b-fwd @mrctl @mral2 ret
  lsft   z    x    c    v    b    n    m    ,    .    /    up   rsft
  fn     lctl lalt lmet          @spc        rmet ralt left down rght
)
