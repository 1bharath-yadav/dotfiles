;; Kanata Power-User Configuration for Arch Linux / Hyprland
;; Main typing layer handles 100% standard alpha typing in browsers and apps.
;; Holding Spacebar / Caps Lock activates the Navigation & Browser Shortcuts Layer.

(defcfg
  process-unmapped-keys yes
  log-layer-changes no
  concurrent-tap-hold yes
)

(defvar
  tap-time 200
  hold-time 180
  chord-time 50
)

(defsrc
  esc    f1   f2   f3   f4   f5   f6   f7   f8   f9   f10  f11  f12
  grv    1    2    3    4    5    6    7    8    9    0    -    =    bspc
  tab    q    w    e    r    t    y    u    i    o    p    [    ]    \
  caps   a    s    d    f    g    h    j    k    l    ;    '    ret
  lsft   z    x    c    v    b    n    m    ,    .    /    up   rsft
  fn     lctl lalt lmet          spc         rmet ralt left down rght
)

(defalias
  ;; Application Key Signals (Matched to Hyprland) — preserved for use in macros/chords
  akitty M-z          ;; Kitty scratchpad (SUPER + Z) or M-ret (Terminal)
  aterm M-ret         ;; Main Terminal
  abrave M-w          ;; Browser (SUPER + W)
  anotes M-A-o        ;; Obsidian (SUPER + ALT + O)
  acalen C-M-c        ;; Calendar (CTRL + SUPER + C)
  afindr M-e          ;; File Manager (SUPER + E)
  acode M-c           ;; Code Editor (SUPER + C)
  akeep C-M-k         ;; Keep (CTRL + SUPER + K)
  atasks C-M-l        ;; Tasks (CTRL + SUPER + L)
  a-mail C-M-m        ;; Gmail (CTRL + SUPER + M)
  aherm M-,           ;; Hermes (SUPER + Comma)
  ayazi M-y           ;; Yazi (SUPER + Y)
  aqnote M--          ;; Quicknote (SUPER + Minus)

  ;; Optimal Home-Row Modifiers (Hyprland Spec)
  ;; Pinky=Ctrl, Ring=Alt, Middle=Super, Index=Shift
  mlctl (tap-hold-release $tap-time $hold-time a lctl)
  mlalt (tap-hold-release $tap-time $hold-time s lalt)
  mlmet (tap-hold-release $tap-time $hold-time d lmet)
  mlsft (tap-hold-release $tap-time $hold-time f lsft)

  mrsft (tap-hold-release $tap-time $hold-time j rsft)
  mrmet (tap-hold-release $tap-time $hold-time k rmet)
  mralt (tap-hold-release $tap-time $hold-time l ralt)
  mrctl (tap-hold-release $tap-time $hold-time ; rctl)

  mtrik (tap-hold $tap-time $hold-time g C-z)
  mral2 (tap-hold-release $tap-time $hold-time ' ralt)

  mcopy (tap-hold $tap-time $hold-time c C-c)
  mpast (tap-hold $tap-time $hold-time v C-v)
  mmtab (tap-hold $tap-time $hold-time z A-tab)
  mmgrv (tap-hold $tap-time $hold-time x A-grv)
  mescc (tap-hold-release $tap-time $hold-time esc lctl)
  maltk (tap-hold $tap-time $hold-time b (macro C-b 20 l))
  mtcop (tap-hold $tap-time $hold-time m (macro C-b 20 v))
  mretu (tap-hold $tap-time $hold-time tab ret)
  mhome (tap-hold $tap-time $hold-time . .)

  ;; Tap = Escape, Hold = Symbol layer
  mcaps (tap-hold-release $tap-time $hold-time esc (layer-toggle symb))
  spc   (tap-hold-release $tap-time $hold-time spc (layer-toggle navi))

  ;; Hold / -> Symbol layer, Tap / -> /
  mrsym (tap-hold-release $tap-time $hold-time / (layer-toggle symb))

  ;; Browser Actions (Used in Navigation Layer)
  b-back A-left
  b-fwd  A-right
  b-ntab C-tab
  b-ptab C-S-tab
  b-new  C-t
  b-cls  C-w
  b-rld  C-r
  b-reop C-S-t
  b-url  C-l
  b-bmrk C-d
)

(defchordsv2
  (w e r) C-= $chord-time first-release ()
  (s d f) C-- $chord-time first-release ()
  (q w e) volu $chord-time first-release ()
  (a s d) vold $chord-time first-release ()
  (spc j k) - $chord-time first-release ()
  (spc j l) S-- $chord-time first-release ()
  (spc u i) grv $chord-time first-release ()
  (spc u o) S-grv $chord-time first-release ()
  (spc m ,) = $chord-time first-release ()
  (spc m .) S-= $chord-time first-release ()
  (spc f g) A-tab $chord-time first-release ()
  (spc s c) S-C-A-M-l $chord-time first-release ()
  (c o p) (macro C-b 20 v 20 S-/ 20 \ . S-2 \ . ret 20 k 20 S-v 20 n 200 y 20 esc) $chord-time first-release ()
  (spc t p) (macro C-b 20 C-y) $chord-time first-release ()
  (spc t n) (macro C-b 20 f) $chord-time first-release ()
  (spc t r) (macro C-b 20 1) $chord-time first-release ()
  (spc t h) (macro @akitty 300 C-b 20 h) $chord-time first-release ()
  (spc t j) (macro @akitty 300 C-b 20 d) $chord-time first-release ()
  (spc t l) (macro @akitty 300 C-b 20 b) $chord-time first-release ()
  (spc t u) (macro @akitty 300 C-b 20 o) $chord-time first-release ()
  (spc t e) (macro @akitty 100 C-b 20 p) $chord-time first-release ()
  (spc caps) caps $chord-time first-release ()
)

;; 1. MAIN LAYER (Default Typing Layer for All Apps & Browsers)
(deflayer main
  esc    f1   f2   f3   f4   f5   f6   f7   f8   f9   f10  f11  f12
  grv    1    2    3    4    5    6    7    8    9    0    -    =    bspc
  @mretu q    w    e    r    t    y    u    i    o    p    [    ]    \
  @mcaps @mlctl @mlalt @mlmet @mlsft @mtrik h    @mrsft @mrmet @mralt @mrctl @mral2 ret
  lsft   @mmtab @mmgrv @mcopy @mpast @maltk n    @mtcop ,    @mhome @mrsym up   rsft
  fn     lctl lalt lmet          @spc        rmet ralt left down rght
)

;; 2. NAVIGATION LAYER (Hold Spacebar or Caps Lock for Arrows & Browser Actions)
(deflayer navi
  lrld   f1   f2   f3   f4   f5   f6   f7   f8   f9   f10  f11  f12
  grv    1    2    3    4    5    6    7    8    9    0    -    =    del
  tab    q    @b-cls _  @b-rld @b-new _  @b-reop @b-url @b-bmrk p [  ]   \
  @mescc @mlctl @mlalt @mlmet @mlsft g   left down up   rght @mrctl @mral2 ret
  lsft   z    x    c    v    b    @b-back @b-ntab @b-ptab @b-fwd / up rsft
  fn     lctl lalt lmet          _           rmet ralt left down rght
)

;; 3. SYMBOL LAYER (Hold Backspace / Caps Lock / Slash) — Numbers & Symbols
(deflayer symb
  esc    f1   f2   f3   f4   f5   f6   f7   f8   f9   f10  f11  f12
  grv    S-1  S-2  S-3  S-4  S-5  S-6  S-7  S-8  S-9  S-0  S--  S-=  bspc
  tab    S-1  S-2  S-3  S-4  S-5  S-6  S-7  S-8  S-9  S-0  S--  S-=  S-\
  esc    1    2    3    4    5    6    7    8    9    0    S-;  ret
  lsft   [    ]    S-,  S-.  -    =    /    \    grv  S-grv up  rsft
  fn     lctl lalt lmet          spc         rmet ralt left down rght
)

;; For more info, see the configuration guide:
;; https://github.com/jtroo/kanata/blob/main/docs/config.adoc
