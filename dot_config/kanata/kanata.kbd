;; Kanata Power-User Configuration for Arch Linux / Hyprland
;; Exact reference home-row modifiers: d/k = Super, a/; = Control, f/j = Alt
;; Symbol layer on home row (1-0 on A-;) + top alpha symbols (!-() + nav/syst/apps/browser layers

(defcfg
  process-unmapped-keys yes
  log-layer-changes no
  concurrent-tap-hold yes
)

(defvar
  tap-time 200
  hold-time 180
  chord-time 50
)

(defsrc
  esc    f1   f2   f3   f4   f5   f6   f7   f8   f9   f10  f11  f12
  grv    1    2    3    4    5    6    7    8    9    0    -    =    bspc
  tab    q    w    e    r    t    y    u    i    o    p    [    ]    \
  caps   a    s    d    f    g    h    j    k    l    ;    '    ret
  lsft   z    x    c    v    b    n    m    ,    .    /    up   rsft
  fn     lctl lalt lmet          spc         rmet ralt left down rght
)

(defalias
  ;; System & Hyper Macro Triggers
  scam6 S-C-A-M-6
  scam0 S-C-A-M-0
  scam9 S-C-A-M-9
  scamt S-C-A-M-tab
  scam= S-C-A-M-=
  scamw S-C-A-M-w
  scamz S-C-A-M-z
  scamd S-C-A-M-d

  ;; Application Key Signals (Caught by Hyprland/Hyprkan)
  akitty S-C-A-M-k
  achrom S-C-A-M-c
  abrave S-C-A-M-b
  avival M-A-e
  adisco S-C-A-M-d
  anotes M-A-o
  acalen C-M-c
  aspoti S-C-A-M-s
  afindr M-e
  asystm S-C-A-M-a
  adavin S-C-A-M-v
  amword S-C-A-M-w
  aexcel S-C-A-M-x
  arecut S-C-A-M-r
  ateams S-C-A-M-t
  ayoutu S-C-A-M-y
  awhats S-C-A-M-h
  asocia S-C-A-M-g
  a--obs S-C-A-M-o
  a1pass S-C-A-M-p
  aforkl S-C-A-M-f
  audemy S-C-A-M-u
  asetap S-C-A-M-i
  awinap S-C-A-M-n
  a-zoom S-C-A-M-z
  aprevw S-C-A-M-q
  aneovd M-c
  a-mail C-M-m
  achatg S-C-A-M-e

  ;; Hardware Controls
  vold vold
  volu volu
  prev prev
  next next
  pp   pp
  brdn brdn
  brup brup
  s-task (macro C-b 20 7)
  scolor S-M-c
  saircn S-C-A-M-1
  sairsw S-C-A-M-2

  ;; Reference Home-Row Modifiers (d/k = Super, a/; = Ctrl, f/j = Alt)
  mlctl (tap-hold-release $tap-time $hold-time a lctl)
  msyst (tap-hold-release $tap-time $hold-time s (layer-toggle syst))
  mlmet (tap-hold-release $tap-time $hold-time d lmet)
  mlalt (tap-hold-release $tap-time $hold-time f lalt)
  mtrik (tap-hold $tap-time $hold-time g C-z)

  mralt (tap-hold-release $tap-time $hold-time j ralt)
  mrmet (tap-hold-release $tap-time $hold-time k rmet)
  mmous (tap-hold-release $tap-time $hold-time l @scamz)
  mrctl (tap-hold-release $tap-time $hold-time ; rctl)
  mral2 (tap-hold-release $tap-time $hold-time ' ralt)

  mcopy (tap-hold $tap-time $hold-time c C-c)
  mpast (tap-hold $tap-time $hold-time v C-v)
  mmtab (tap-hold $tap-time $hold-time z A-tab)
  mmgrv (tap-hold $tap-time $hold-time x A-grv)
  mescc (tap-hold $tap-time $hold-time esc caps)
  maltk (tap-hold $tap-time $hold-time b (macro C-b 20 l))
  mtcop (tap-hold $tap-time $hold-time m (macro C-b 20 v))
  mretu (tap-hold $tap-time $hold-time tab ret)
  mhome (tap-hold $tap-time $hold-time . @scam6)

  mappr (tap-hold-press $tap-time $hold-time ret (layer-toggle apps))
  msymb (tap-hold $tap-time $hold-time bspc (layer-toggle symb))
  mnavi (tap-hold-press $tap-time $hold-time esc (layer-toggle navi))
  mhypr (tap-hold $tap-time $hold-time spc (layer-toggle navi))
  spc (tap-hold-release $tap-time $hold-time spc (layer-toggle navi))

  ;; Browser Action Aliases (Hyprkan Context)
  b-back A-left
  b-fwd  A-right
  b-ntab C-tab
  b-ptab C-S-tab
  b-new  C-t
  b-cls  C-w
  b-rld  C-r
  b-reop C-S-t
  b-url  C-l
  b-bmrk C-d
)

(defchordsv2
  (w e r) C-= $chord-time first-release ()
  (s d f) C-- $chord-time first-release ()
  (q w e) volu $chord-time first-release ()
  (a s d) vold $chord-time first-release ()
  (spc j k) - $chord-time first-release ()
  (spc j l) S-- $chord-time first-release ()
  (spc u i) ` $chord-time first-release ()
  (spc u o) S-` $chord-time first-release ()
  (spc m ,) = $chord-time first-release ()
  (spc m .) S-= $chord-time first-release ()
  (spc f g) A-tab $chord-time first-release ()
  (spc s c) S-C-A-M-l $chord-time first-release ()
  (c o p) (macro C-b 20 v 20 S-/ 20 \ . S-2 \ . ret 20 k 20 S-v 20 n 200 y 20 esc) $chord-time first-release ()
  (spc t p) (macro C-b 20 C-y) $chord-time first-release ()
  (spc t n) (macro C-b 20 f) $chord-time first-release ()
  (spc t r) (macro C-b 20 1) $chord-time first-release ()
  (spc t h) (macro @akitty 300 C-b 20 h) $chord-time first-release ()
  (spc t j) (macro @akitty 300 C-b 20 d) $chord-time first-release ()
  (spc t l) (macro @akitty 300 C-b 20 b) $chord-time first-release ()
  (spc t u) (macro @akitty 300 C-b 20 o) $chord-time first-release ()
  (spc t e) (macro @akitty 100 C-b 20 p) $chord-time first-release ()
  (spc caps) caps $chord-time first-release ()
)

;; 1. MAIN LAYER (Reference Layout: d/k = Super, a/; = Ctrl, f/j = Alt, s = Syst)
(deflayer main
  esc    f1   f2   f3   f4   f5   f6   f7   f8   f9   f10  f11  f12
  grv    1    2    3    4    5    6    7    8    9    0    -    =    bspc
  @mretu q    w    e    r    t    y    u    i    o    p    [    ]    \
  @mnavi @mlctl @msyst @mlmet @mlalt @mtrik h    @mralt @mrmet @mmous @mrctl @mral2 @mappr
  lsft   @mmtab @mmgrv @mcopy @mpast @maltk n    @mtcop ,    @mhome /    up   rsft
  fn     lctl lalt lmet          @spc        rmet ralt left down rght
)

;; 2. NAVIGATION LAYER (Hold Spacebar or Caps Lock)
(deflayer navi
  lrld   f1   f2   f3   f4   f5   f6   f7   f8   f9   f10  f11  f12
  grv    1    2    3    4    5    6    7    8    9    0    -    =    del
  tab    _    _    _    _    _    _    home pgdn pgup end  _    _    _
  @mescc  @mlctl @msyst @mlmet @mlalt _    left down up   rght _    _    ret
  lsft   _    _    _    _    _    _    _    _    _    _    up   rsft
  fn     lctl lalt lmet          _           rmet ralt left down rght
)

;; 3. SYMBOL LAYER (Hold Backspace) — Numbers 1-0 on Home Row, Symbols !-) on Top Row
(deflayer symb
  esc    f1   f2   f3   f4   f5   f6   f7   f8   f9   f10  f11  f12
  grv    1    2    3    4    5    6    7    8    9    0    -    =    bspc
  tab    S-1  S-2  S-3  S-4  S-5  S-6  S-7  S-8  S-9  S-0  [    ]    \
  caps   1    2    3    4    5    6    7    8    9    0    '    ret
  lsft   z    x    c    v    b    [    S-[  S-]  ]    /    up   rsft
  fn     lctl lalt lmet          bspc        rmet ralt left down rght
)

;; 4. SYSTEM CONTROL LAYER (Hold S key)
(deflayer syst
  esc    f1   f2   f3   f4   f5   f6   f7   f8   f9   f10  f11  f12
  grv    1    2    3    4    5    6    7    8    9    0    -    =    bspc
  tab    _    _    _    _    _    prev vold volu next pp   _    _    _
  caps   @mlctl @msyst @mlmet @mlalt _    _    @mralt @mrmet @mmous @mrctl ' ret
  lsft   _    _    @scolor brdn brup _  _    _    _    _    up   rsft
  fn     lctl lalt lmet          lrld        rmet ralt left down rght
)

;; 5. APPS LAUNCHER LAYER (Hold Enter key)
(deflayer apps
  esc    f1   f2   f3   f4   f5   f6   f7   f8   f9   f10  f11  f12
  grv    1    2    3    4    5    6    7    8    9    0    -    =    bspc
  tab   @adavin @amword @aexcel @arecut @ateams @ayoutu @awhats @asocia @a--obs @a1pass [ ] \
  caps  @afindr _    @adisco @aforkl @achrom @aspoti @akitty @abrave _    @achatg @asystm ret
  lsft  @a-zoom @anotes @acalen @aprevw @avival @aneovd @a-mail @awinap _ _ up rsft
  fn     lctl lalt lmet          spc         rmet ralt left down rght
)

;; 6. BROWSER LAYER (HYPRKAN CONTEXT-AWARE)
(deflayer browser
  esc    f1   f2   f3   f4   f5   f6   f7   f8   f9   f10  f11  f12
  grv    1    2    3    4    5    6    7    8    9    0    -    =    bspc
  tab    q    @b-cls _  @b-rld @b-new _  @b-reop @b-url @b-bmrk p [ ] \
  @mescc  @mlctl @msyst @mlmet @mlalt g    @b-back @b-ntab @b-ptab @b-fwd @mrctl @mral2 ret
  lsft   z    x    c    v    b    n    m    ,    .    /    up   rsft
  fn     lctl lalt lmet          @spc        rmet ralt left down rght
)
