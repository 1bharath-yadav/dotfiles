[Unit]
Description=Dedicated Google Chrome Stable CDP Browser (xoy)
After=graphical-session.target
Wants=graphical-session.target

[Service]
Type=simple
Environment=HOME=%h
Environment=USER=%u
Environment=DISPLAY=:1
Environment=WAYLAND_DISPLAY=wayland-1
Environment=XDG_RUNTIME_DIR=/run/user/%U
Environment=DBUS_SESSION_BUS_ADDRESS=unix:path=/run/user/%U/bus
Environment=CDP_CHROME_PROFILE=%h/.config/xoy
Environment=CDP_CHROME_PORT=9222
ExecStart=%h/.local/bin/start-xoy-cdp.sh
Restart=always
RestartSec=5

[Install]
WantedBy=default.target
