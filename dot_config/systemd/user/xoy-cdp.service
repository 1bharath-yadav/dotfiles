[Unit]
Description=xoy Chrome (CDP on :9222)
After=graphical-session.target
Wants=graphical-session.target

[Service]
Type=exec
ExecStart=%h/.local/bin/start-xoy-cdp.sh --foreground
ExecStop=%h/.local/bin/stop-xoy-cdp.sh --direct
Restart=on-failure
RestartSec=5
KillMode=mixed
TimeoutStopSec=40

[Install]
WantedBy=default.target
