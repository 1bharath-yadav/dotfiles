[Unit]
Description=Cloudflare Tunnel for Mitham
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
Environment=HOME=%h
Environment=PATH=/usr/local/bin:/usr/bin:/bin:%h/.local/bin
ExecStart=/usr/bin/cloudflared tunnel run --config %h/.cloudflared/config.yml mitham
Restart=always
RestartSec=5
TimeoutStopSec=15
NoNewPrivileges=yes
PrivateTmp=yes
UMask=0077
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=mitham.target
