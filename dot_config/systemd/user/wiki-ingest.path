[Unit]
Description=Watch inbox markdown files for LLM-Wiki ingest
Documentation=file:///home/archer/.nanobot/workspace/ai_workflow_optimisation.md

[Path]
# Trigger when new markdown files appear in the inbox queue.
# Keep a few depth levels to cover common folder structures.
PathExistsGlob=%h/Sync/obsidian_vault/til/inbox/*.md
PathExistsGlob=%h/Sync/obsidian_vault/til/inbox/*/*.md
PathExistsGlob=%h/Sync/obsidian_vault/til/inbox/*/*/*.md
Unit=wiki-ingest.service

[Install]
WantedBy=default.target
