[Unit]
Description=Screenpipe — always-on capture/serve
Wants=network-online.target
After=network-online.target graphical-session.target

[Service]
Type=simple
WorkingDirectory=%h
ExecStart=/usr/bin/mise exec -- screenpipe record --disable-audio --disable-meeting-detector --retention-days 30 --retention-mode media --min-capture-interval-ms 2000
Restart=always
RestartSec=5

Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin
Environment=XDG_RUNTIME_DIR=/run/user/1000
Environment=DBUS_SESSION_BUS_ADDRESS=unix:path=/run/user/1000/bus
Environment=WAYLAND_DISPLAY=wayland-1
Environment=XDG_SESSION_TYPE=wayland
Environment=XDG_CURRENT_DESKTOP=Hyprland
Environment=XDG_SESSION_DESKTOP=Hyprland
Environment=SCREENPIPE_NO_REMINDERS=1

[Install]
WantedBy=default.target
