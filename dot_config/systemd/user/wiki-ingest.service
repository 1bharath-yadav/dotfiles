[Unit]
Description=LLM-Wiki Inbox Compiler Service
After=network.target

[Service]
Type=oneshot
WorkingDirectory=/home/archer/projects/externel/llm-wiki-agent
ExecStart=/home/archer/projects/externel/llm-wiki-agent/.venv/bin/python \
          /home/archer/projects/externel/llm-wiki-agent/tools/ingest.py \
          --inbox
Environment="PATH=/home/archer/.local/bin:/usr/local/bin:/usr/bin:/bin"

[Install]
WantedBy=default.target
