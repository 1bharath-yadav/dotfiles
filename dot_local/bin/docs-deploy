#!/usr/bin/env bash
# Deploy dotfiles docs to GitHub Pages (gh-pages branch).
# Usage: docs-deploy [--preview]
set -euo pipefail

DOTFILES="${DOTFILES:-$HOME/.dotfiles}"
MKDOCS="$HOME/.local/bin/mkdocs"

if [[ "${1:-}" == "--preview" ]]; then
  echo "→ Serving locally at http://127.0.0.1:8000"
  exec "$MKDOCS" serve --config-file "$DOTFILES/mkdocs.yml"
fi

# Sync agent skills into docs/skills/ so they appear on the site
mkdir -p "$DOTFILES/docs/skills"
for skill in "$DOTFILES/agents/"*.skill.md; do
  [[ -e "$skill" ]] || continue
  name=$(basename "$skill" .skill.md)
  cp "$skill" "$DOTFILES/docs/skills/$name.md"
done

echo "→ Deploying to gh-pages branch..."
"$MKDOCS" gh-deploy \
  --config-file "$DOTFILES/mkdocs.yml" \
  --remote-branch gh-pages \
  --message "docs: deploy $(date +%Y-%m-%d)"

echo "✓ Live at https://1bharath-yadav.github.io/dotfiles"
