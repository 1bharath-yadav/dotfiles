#!/usr/bin/env bash
set -euo pipefail

# sync-external-tools — keep all tools up to date.
# Now that we use mise for everything, this is mostly a wrapper for `mise install`.

has() { command -v "$1" >/dev/null 2>&1; }

main() {
  if has mise; then
    echo "Syncing tools with mise..."
    mise install
    mise prune
    mise upgrade
  else
    echo "mise not found, skipping tool sync."
  fi
}

main "$@"