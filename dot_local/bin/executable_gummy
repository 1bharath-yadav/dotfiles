#!/usr/bin/env bash
set -euo pipefail

usage() {
  cat <<'USAGE'
Usage: gummy <binary> [args...]
       gummy --help

Interactive CLI builder using Gum + completion metadata.
USAGE
}

need() { command -v "$1" >/dev/null 2>&1 || { echo "gummy: missing dependency: $1" >&2; exit 127; }; }
need gum; need sed; need awk; need grep; need mktemp
[[ $# -gt 0 ]] || { usage; exit 2; }
[[ ${1:-} == -h || ${1:-} == --help ]] && { usage; exit 0; }

bin="$1"; shift
command -v -- "$bin" >/dev/null 2>&1 || { echo "gummy: command not found: $bin" >&2; exit 127; }

help_text="$({ "$bin" --help; } 2>&1 || true)"
[[ -n "$help_text" ]] || help_text="$({ "$bin" -h; } 2>&1 || true)"

if [[ "$bin" == hyprctl ]] && [[ -z "${HYPRLAND_INSTANCE_SIGNATURE:-}" ]]; then
  echo "gummy: hyprctl needs an active Hyprland session (HYPRLAND_INSTANCE_SIGNATURE)." >&2
  exit 1
fi

if [[ "$bin" == docker || "$bin" == podman || "$bin" == kubectl || "$bin" == git || "$bin" == systemctl || "$bin" == hyprctl ]]; then
  mapfile -t subcommands < <(
    printf '%s\n' "$help_text" |
      sed -nE 's/^[[:space:]]{2,}([a-z][a-z0-9_-]+)[[:space:]]{2,}.*/\1/p' |
      awk '!seen[$0]++' | head -n 100
  )
else
  subcommands=()
fi

gum style --border rounded --padding '0 1' --bold "gummy · $bin"
declare -a args=("$@")

if ((${#subcommands[@]})); then
  mapfile -t picked < <(printf '%s\n' "${subcommands[@]}" | gum filter --header 'Command · type to filter, Enter to select' --height 15)
  if ((${#picked[@]})); then
    sub="${picked[0]}"
    args+=("$sub")
    sub_help="$({ "$bin" "$sub" --help; } 2>&1 || { "$bin" "$sub" -h; } 2>&1 || true)"
  fi
else
  sub_help="$help_text"
fi

mapfile -t options < <(
  printf '%s\n' "$sub_help" |
  sed -nE 's/^[[:space:]]*(-[[:alnum:]]),[[:space:]]+(--[[:alnum:]_-]+).*/\1 \/ \2/p; s/^[[:space:]]*(-[[:alnum:]]{1,3})[[:space:]]+([^[:space:]].*).*/\1 \/ \2/p; s/^[[:space:]]*(--[[:alnum:]_-]+)([=[:space:]].*)?$/\1/p' |
  awk '!seen[$0]++' | head -n 120
)

if ((${#options[@]})); then
  mapfile -t chosen < <(printf '%s\n' "${options[@]}" | gum choose --no-limit --header 'Options · Space select, Enter confirm' --height 18)
  for item in "${chosen[@]}"; do
    flag="${item%% *}"
    [[ "$item" == *' / '* ]] && flag="${item%% / *}"
    # Avoid duplicate slash-form tokens and obvious help/version switches.
    [[ "$flag" == '-h' || "$flag" == '--help' || "$flag" == '--version' ]] && continue
    if grep -Eiq "(${flag}[^[:alnum:]].*(FILE|PATH|DIR|URL|NAME|VALUE|STRING|PATTERN|FORMAT|OUTPUT|INPUT|PORT|HOST|COMMAND|CMD|NUMBER|NUM)|${flag}=[A-Z_<])" <<< "$sub_help"; then
      value="$(gum input --prompt "$flag= " --placeholder 'value')"
      [[ -n "$value" ]] && args+=("$flag" "$value")
    else
      args+=("$flag")
    fi
  done
fi

while gum confirm --default=false 'Add argument/value?'; do
  value="$(gum input --prompt 'arg> ' --placeholder 'file, path, image, container, service, ...')"
  [[ -n "$value" ]] && args+=("$value")
done

cmd_display="$bin"
for a in "${args[@]}"; do cmd_display+=" $(printf '%q' "$a")"; done

gum style --border rounded --padding '0 1' --bold "Ready"
printf '%s\n' "$cmd_display"
gum confirm --default=true 'Execute this command?' || exit 0
exec "$bin" "${args[@]}"
