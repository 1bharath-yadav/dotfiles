#!/usr/bin/env bash
set -euo pipefail

PORT="${PORT:-22}"
SSHD="/usr/bin/sshd"

# Start sshd if needed
if ! pgrep -x sshd >/dev/null; then
    sudo "$SSHD"
fi

# Wait up to 5 seconds for sshd to listen
for _ in {1..10}; do
    if ss -H -ltn "( sport = :$PORT )" 2>/dev/null | grep -q .; then
        break
    fi
    sleep 0.5
done

if ! ss -H -ltn "( sport = :$PORT )" 2>/dev/null | grep -q .; then
    echo "ERROR: sshd is not listening on port $PORT"
    exit 1
fi

# Get best IPv4 address
IP=""

# Method 1 (preferred)
IP=$(ip -4 route get 1.1.1.1 2>/dev/null \
    | sed -n 's/.* src \([0-9.]*\).*/\1/p' \
    | head -n1)

# Method 2 fallback
if [[ -z "$IP" ]]; then
    IP=$(hostname -I 2>/dev/null | awk '{print $1}')
fi

# Validate IPv4
if ! [[ "$IP" =~ ^([0-9]{1,3}\.){3}[0-9]{1,3}$ ]]; then
    echo "ERROR: Could not determine a valid IPv4 address"
    exit 1
fi

CMD="ssh $(id -un)@$IP"

echo
echo "$CMD"
echo

if command -v qrencode >/dev/null 2>&1; then
    qrencode -t ansiutf8 "$CMD"
fi
