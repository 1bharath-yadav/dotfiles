#!/usr/bin/env bash
# tool-doctor — Canonical developer toolchain and environment diagnostics
set -euo pipefail

if command -v linux-agent >/dev/null 2>&1; then
  exec linux-agent doctor "$@"
elif [[ -x "$HOME/.local/bin/linux-agent" ]]; then
  exec "$HOME/.local/bin/linux-agent" doctor "$@"
else
  exec "$HOME/.dotfiles/dot_local/bin/executable_linux-agent" doctor "$@"
fi
