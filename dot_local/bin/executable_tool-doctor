#!/usr/bin/env bash
set -euo pipefail

echo '== pacman =='
command -v pacman >/dev/null 2>&1 && pacman -Q mise git base-devel gcc openssl zlib 2>/dev/null || true

echo
printf '== runtimes ==\n'
command -v mise >/dev/null 2>&1 && mise ls || true

echo
printf '== commands ==\n'
for cmd in mise node pnpm python uv cargo rustc; do
  if command -v "$cmd" >/dev/null 2>&1; then
    printf '%-8s %s\n' "$cmd" "$(command -v "$cmd")"
  else
    printf '%-8s missing\n' "$cmd"
  fi
done
