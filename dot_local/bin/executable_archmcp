#!/usr/bin/env bash
set -euo pipefail

command -v gum >/dev/null 2>&1 || { echo "archmcp: gum is required" >&2; exit 127; }
[[ -f "$HOME/.env" ]] && source "$HOME/.env"

declare -a LABELS=(
  "Filesystem (/home/archer)"
  "Desktop Commander (Remote)"
  "Local Bash MCP (local_mcp)"
)
declare -a CMDS=(
  "npx -y @modelcontextprotocol/server-filesystem /home/archer"
  "npx -y @wonderwhy-er/desktop-commander@latest remote"
  "local_mcp"
)

gum style --border rounded --padding '0 1' --bold 'archmcp · server launcher'
selection="$(printf '%s\n' "${LABELS[@]}" | gum choose --no-limit --header 'Space select · Enter confirm' --cursor '▶ ')"
[[ -n "$selection" ]] || { gum style --foreground 214 'No servers selected.'; exit 0; }

pids=()
cleanup() {
  trap - EXIT INT TERM
  for pid in "${pids[@]:-}"; do kill "$pid" 2>/dev/null || true; done
  wait 2>/dev/null || true
}
trap cleanup EXIT INT TERM

while IFS= read -r choice; do
  [[ -n "$choice" ]] || continue
  idx=-1
  for i in "${!LABELS[@]}"; do
    [[ "${LABELS[$i]}" == "$choice" ]] && idx="$i"
  done
  (( idx >= 0 )) || continue
  gum style --foreground 82 "Starting: ${LABELS[$idx]}"
  bash -lc "${CMDS[$idx]}" &
  pids+=("$!")
done <<< "$selection"

if ((${#pids[@]} == 0)); then
  gum style --foreground 196 'No valid servers selected.'
  exit 1
fi

gum style --foreground 82 "${#pids[@]} server(s) started · Ctrl+C stops all"
wait
