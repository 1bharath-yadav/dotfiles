#!/usr/bin/env bash
# Fetch, normalize, and display trending GitHub repositories in datui
CACHE_FILE="${XDG_CACHE_HOME:-$HOME/.cache}/trending-repos.tsv"
mkdir -p "${CACHE_FILE%/*}"
curl -fsSL "https://raw.githubusercontent.com/sanand0/til/refs/heads/main/trending-repos.tsv" | awk -F'\t' 'BEGIN {OFS="\t"; print "status\tlanguage\tstars\tstars_today\tdate\trepository\tdescription\tnotes"} {print $1, $2, $3, $4, $5, $6, $7, $8}' > "$CACHE_FILE"
exec datui "$CACHE_FILE" --format tsv "$@"
