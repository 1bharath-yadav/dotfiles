#!/usr/bin/env bash
# trending-repos: Fetch, format, and display trending GitHub repositories in datui.
# Source TSV: https://raw.githubusercontent.com/sanand0/til/refs/heads/main/trending-repos.tsv
set -euo pipefail

CACHE_DIR="${XDG_CACHE_HOME:-$HOME/.cache}/trending-repos"
CACHE_FILE="$CACHE_DIR/trending-repos.tsv"
TSV_URL="https://raw.githubusercontent.com/sanand0/til/refs/heads/main/trending-repos.tsv"
CACHE_TTL_HOURS=6

usage() {
    cat <<EOF
Usage: $(basename "$0") [OPTIONS] [-- DATUI_OPTIONS]

Fetches and displays GitHub trending repositories in datui with clean formatting,
thousands digit grouping, and automated column locking.

Options:
  -r, --refresh    Force re-fetch of latest trending data
  -h, --help       Show this help message
EOF
}

refresh=0
datui_args=()

while [[ $# -gt 0 ]]; do
    case "$1" in
        -r|--r|--refresh)
            refresh=1
            shift
            ;;
        -h|--help)
            usage
            exit 0
            ;;
        --)
            shift
            datui_args+=("$@")
            break
            ;;
        *)
            datui_args+=("$1")
            shift
            ;;
    esac
done

mkdir -p "$CACHE_DIR"

needs_fetch=0
if [[ $refresh -eq 1 || ! -f "$CACHE_FILE" ]]; then
    needs_fetch=1
elif test "$(find "$CACHE_FILE" -mmin +$((CACHE_TTL_HOURS * 60)) 2>/dev/null)"; then
    needs_fetch=1
fi

if [[ $needs_fetch -eq 1 ]]; then
    echo "Fetching latest trending repositories..." >&2
    RAW_DATA=$(curl -fsSL "$TSV_URL")

    python3 -c "
import sys, re

raw = sys.stdin.read()
lines = [l for l in raw.split('\n') if l.strip()]

out = []
out.append(['status', 'language', 'stars', 'stars_today', 'date', 'repository', 'description', 'notes'])

for line in lines:
    cols = line.split('\t')
    if not cols or not cols[0].strip():
        continue
    status = cols[0].strip()
    lang = cols[1].strip() if len(cols) > 1 else ''
    stars = re.sub(r'[^\d]', '', cols[2]) if len(cols) > 2 else '0'
    stars_today = re.sub(r'[^\d]', '', cols[3]) if len(cols) > 3 else '0'
    date = cols[4].strip() if len(cols) > 4 else ''
    repo = cols[5].strip() if len(cols) > 5 else ''
    desc = cols[6].strip() if len(cols) > 6 else ''
    notes = cols[7].strip() if len(cols) > 7 else ''

    desc = desc.replace('\t', ' ').replace('\n', ' ')
    notes = notes.replace('\t', ' ').replace('\n', ' ')

    out.append([status, lang, stars, stars_today, date, repo, desc, notes])

tsv_content = '\n'.join('\t'.join(row) for row in out)
with open('$CACHE_FILE', 'w', encoding='utf-8') as f:
    f.write(tsv_content + '\n')
" <<< "$RAW_DATA"
fi

exec datui "$CACHE_FILE" --row-numbers --number-format thousands "${datui_args[@]}"
