#!/usr/bin/env bash
# Fetch trending GitHub repositories TSV, normalize 8-field schema, and open in datui
exec datui <(curl -fsSL "https://raw.githubusercontent.com/sanand0/til/refs/heads/main/trending-repos.tsv" | awk -F'\t' 'BEGIN {OFS="\t"; print "status\tlanguage\tstars\tstars_today\tdate\trepository\tdescription\tnotes"} {print $1, $2, $3, $4, $5, $6, $7, $8}') --format tsv "$@"
