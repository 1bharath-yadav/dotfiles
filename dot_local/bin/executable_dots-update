END4DOTS="${END4DOTS:-$HOME/.local/share/end4dots}"

log() {
  echo "[INFO] $*" >&2
}

warn() {
  echo "[WARN] $*" >&2
}

sync_end4dots() {
  [[ -d "$END4DOTS" ]] || return 0

  log "Syncing end4dots with upstream"

  cd "$END4DOTS"
  git remote get-url upstream >/dev/null 2>&1 || git remote add upstream https://github.com/end-4/dots-hyprland.git

  # Update main branch (upstream mirror)
  git fetch upstream -q

  "$END4DOTS/setup" exp-update

}

[[ $(uname) == Linux ]] && grep -qi "arch" /etc/os-release && sync_end4dots || warn "End4dots sync skipped (not Arch Linux or sync failed)"

command -v dots-migrate >/dev/null 2>&1 && dots-migrate || warn "dots-migrate not found on PATH; skipping migrations"
