#!/usr/bin/env bash
set -euo pipefail

# Multi-provider CDP CLI router for ChatGPT, Claude, Gemini, DeepSeek, Z.ai, MiniMax, Kimi, Grok, Qwen
AGENTS_DIR=""
if [[ -d "$HOME/projects/cdp-agents" ]]; then
    AGENTS_DIR="$HOME/projects/cdp-agents"
elif [[ -d "$HOME/.agents/skills/cdp-agents" ]]; then
    AGENTS_DIR="$HOME/.agents/skills/cdp-agents"
elif [[ -d "$HOME/.dotfiles/agents/skills/cdp-agents" ]]; then
    AGENTS_DIR="$HOME/.dotfiles/agents/skills/cdp-agents"
else
    echo "Error: cdp-agents directory not found in ~/projects, ~/.agents, or ~/.dotfiles" >&2
    exit 1
fi

BN="$(basename "$0")"
PROVIDER="chatgpt"

# Check invocation alias
case "$BN" in
    claude*|ai-claude) PROVIDER="claude" ;;
    gemini*|ai-gemini) PROVIDER="gemini" ;;
    deepseek*|ai-deepseek) PROVIDER="deepseek" ;;
    zai*|z-ai*|ai-zai) PROVIDER="zai" ;;
    minimax*|ai-minimax) PROVIDER="minimax" ;;
    kimi*|ai-kimi) PROVIDER="kimi" ;;
    grok*|ai-grok) PROVIDER="grok" ;;
    qwen*|ai-qwen) PROVIDER="qwen" ;;
    mistral*|ai-mistral) PROVIDER="mistral" ;;
    meta*|ai-meta) PROVIDER="meta" ;;
    copilot*|ai-copilot) PROVIDER="copilot" ;;
esac

# Parse provider override flags
ARGS=()
while [[ $# -gt 0 ]]; do
    case "$1" in
        --claude)
            PROVIDER="claude"
            shift
            ;;
        --gemini)
            PROVIDER="gemini"
            shift
            ;;
        --deepseek)
            PROVIDER="deepseek"
            shift
            ;;
        --zai|--z-ai)
            PROVIDER="zai"
            shift
            ;;
        --minimax)
            PROVIDER="minimax"
            shift
            ;;
        --kimi)
            PROVIDER="kimi"
            shift
            ;;
        --grok)
            PROVIDER="grok"
            shift
            ;;
        --qwen)
            PROVIDER="qwen"
            shift
            ;;
        --mistral)
            PROVIDER="mistral"
            shift
            ;;
        --meta)
            PROVIDER="meta"
            shift
            ;;
        --copilot)
            PROVIDER="copilot"
            shift
            ;;
        --chatgpt)
            PROVIDER="chatgpt"
            shift
            ;;
        --provider|-P)
            if [[ $# -ge 2 ]]; then
                PROVIDER="$2"
                shift 2
            else
                ARGS+=("$1")
                shift
            fi
            ;;
        *)
            ARGS+=("$1")
            shift
            ;;
    esac
done

SCRIPT=""
case "$PROVIDER" in
    claude)
        SCRIPT="$AGENTS_DIR/claude/claude.py"
        ;;
    gemini)
        SCRIPT="$AGENTS_DIR/gemini/gemini.py"
        ;;
    deepseek)
        SCRIPT="$AGENTS_DIR/deepseek/deepseek.py"
        ;;
    zai|z-ai)
        SCRIPT="$AGENTS_DIR/zai/zai.py"
        ;;
    minimax)
        SCRIPT="$AGENTS_DIR/minimax/minimax.py"
        ;;
    kimi)
        SCRIPT="$AGENTS_DIR/kimi/kimi.py"
        ;;
    grok)
        SCRIPT="$AGENTS_DIR/grok/grok.py"
        ;;
    qwen)
        SCRIPT="$AGENTS_DIR/qwen/qwen.py"
        ;;
    mistral)
        SCRIPT="$AGENTS_DIR/mistral/mistral.py"
        ;;
    meta)
        SCRIPT="$AGENTS_DIR/meta/meta.py"
        ;;
    copilot)
        SCRIPT="$AGENTS_DIR/copilot/copilot.py"
        ;;
    chatgpt|*)
        SCRIPT="$AGENTS_DIR/chatgpt/chatgpt.py"
        ;;
esac

if [[ ! -f "$SCRIPT" ]]; then
    echo "Error: Provider script not found: $SCRIPT" >&2
    exit 1
fi

exec python3 "$SCRIPT" "${ARGS[@]}"
