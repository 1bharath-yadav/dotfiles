#!/usr/bin/env bash
# cdp-browser wrapper
# Ensures xoy-cdp service is running on port 9222 and executes agent-browser over CDP.
# NEVER uses Playwright. Exclusively connects to dedicated XOY Chrome instance via CDP 9222.
set -euo pipefail

AGENT_BROWSER_BIN="${AGENT_BROWSER_BIN:-/home/archer/.local/share/mise/installs/npm-agent-browser/latest/node_modules/.bin/agent-browser}"
CDP_PORT="${CDP_PORT:-9222}"
CDP_URL="http://127.0.0.1:${CDP_PORT}"

if [[ ! -x "$AGENT_BROWSER_BIN" ]]; then
  AGENT_BROWSER_BIN="$(which agent-browser 2>/dev/null || true)"
fi

if [[ -z "$AGENT_BROWSER_BIN" || ! -x "$AGENT_BROWSER_BIN" ]]; then
  echo "Error: agent-browser binary not found." >&2
  exit 1
fi

# Check if xoy-cdp service is reachable
if ! curl -fsS --max-time 1 "${CDP_URL}/json/version" >/dev/null 2>&1; then
  echo "[cdp-browser] xoy-cdp not responding on port ${CDP_PORT}. Starting xoy-cdp.service..." >&2
  systemctl --user start xoy-cdp 2>/dev/null || bash "$HOME/.local/bin/start-xoy-cdp.sh" >/dev/null 2>&1 &

  # Wait for port 9222 to become available (up to 6 seconds)
  READY=0
  for _ in {1..12}; do
    sleep 0.5
    if curl -fsS --max-time 1 "${CDP_URL}/json/version" >/dev/null 2>&1; then
      READY=1
      echo "[cdp-browser] xoy-cdp online on port ${CDP_PORT}." >&2
      break
    fi
  done

  if [[ "$READY" -ne 1 ]]; then
    echo "Error: Failed to connect to xoy-cdp on port ${CDP_PORT} after startup." >&2
    exit 2
  fi
fi

# Execute agent-browser targeting CDP port 9222
exec "$AGENT_BROWSER_BIN" --cdp "$CDP_PORT" "$@"
