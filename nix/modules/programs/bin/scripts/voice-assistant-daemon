#!/usr/bin/env bash
# voice-assistant-daemon: persistent Letta daemon for Quickshell UI.
# Usage: voice-assistant-daemon [pipe|text|cancel]
#   pipe   — read one line from stdin, stream response via QS IPC
#   text   — read one line from stdin, stream tokens to stdout
#   cancel — write cancel file so the running stream stops

set -euo pipefail

VENV_DIR="$HOME/.local/state/voice-assistant/venv"
DOTFILES_DIR="${DOTFILES_DIR:-$HOME/.dotfiles}"
PKG_DIR="$DOTFILES_DIR/libs/letta_assistant"
PYTHON="$VENV_DIR/bin/python"
CANCEL_FILE="/tmp/voice-assistant-cancel"

_ensure_venv() {
  if [[ ! -f "$PYTHON" ]]; then
    python3 -m venv "$VENV_DIR" >&2
    "$VENV_DIR/bin/pip" install -q -e "$PKG_DIR" >&2
  fi
}

_get_api_key() {
  local key="${LETTA_API_KEY:-}"
  if [[ -z "$key" ]]; then
    key=$(secret-tool lookup letta_key sk 2>/dev/null || true)
  fi
  echo "$key"
}

cmd_pipe() {
  local text
  text=$(cat)
  [[ -z "${text// }" ]] && exit 0
  rm -f "$CANCEL_FILE"
  _ensure_venv
  local api_key
  api_key=$(_get_api_key)
  [[ -z "$api_key" ]] && { quickshell -c ii ipc call voiceAssistant status error 2>/dev/null || true; exit 1; }
  export LETTA_API_KEY="$api_key"
  exec "$PYTHON" -m letta_assistant.daemon pipe "$text"
}

cmd_text() {
  local text
  text=$(cat)
  [[ -z "${text// }" ]] && exit 0
  rm -f "$CANCEL_FILE"
  _ensure_venv
  local api_key
  api_key=$(_get_api_key)
  [[ -z "$api_key" ]] && { echo "[ERROR] Missing LETTA_API_KEY" >&2; exit 1; }
  export LETTA_API_KEY="$api_key"
  exec "$PYTHON" -m letta_assistant.daemon text "$text"
}

cmd_cancel() {
  touch "$CANCEL_FILE"
}

case "${1:-pipe}" in
  pipe)   cmd_pipe   ;;
  text)   cmd_text   ;;
  cancel) cmd_cancel ;;
  *) echo "Usage: voice-assistant-daemon [pipe|text|cancel]" >&2; exit 1 ;;
esac
