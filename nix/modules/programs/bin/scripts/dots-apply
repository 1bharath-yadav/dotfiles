#!/usr/bin/env bash
set -euo pipefail

DOTFILES="${DOTFILES:-$HOME/.dotfiles}"

if [[ $# -eq 0 ]]; then
  exec bash "$DOTFILES/setup/main.sh" apply all auto
fi

case "$1" in
  arch|wsl|ubuntu|termux|auto)
    exec bash "$DOTFILES/setup/main.sh" apply all "$1"
    ;;
  pacman|home|system|external|all)
    exec bash "$DOTFILES/setup/main.sh" apply "$@"
    ;;
  *)
    echo "usage: dots-apply [pacman|home|system|external|all] [arch|wsl|ubuntu|termux|auto]" >&2
    exit 1
    ;;
esac