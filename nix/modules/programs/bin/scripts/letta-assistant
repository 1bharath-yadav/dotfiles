#!/usr/bin/env bash
# letta-assistant — Interactive REPL for Letta agents
# Uses same venv as voice-assistant for consistency

set -euo pipefail

VENV_DIR="$HOME/.local/state/voice-assistant/venv"
DOTFILES_DIR="${DOTFILES_DIR:-$HOME/.dotfiles}"
PKG_DIR="$DOTFILES_DIR/libs/letta_assistant"

# Check if venv exists
if [[ ! -f "$VENV_DIR/bin/python" ]]; then
    echo "Setting up Python environment..." >&2
    
    # Create venv if missing
    python3 -m venv "$VENV_DIR"
    
    # Install package in editable mode
    "$VENV_DIR/bin/pip" install -q -e "$PKG_DIR"
fi

# Note: LETTA_API_KEY is handled by Python (letta_assistant.py)
# It will prompt the user if needed and store the key using the secrets tool

# Run REPL (Python will handle API key retrieval/prompting)
exec "$VENV_DIR/bin/python" -m letta_assistant "$@"
