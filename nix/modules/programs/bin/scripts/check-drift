#!/usr/bin/env bash
# bin/check-drift — compare explicitly-installed pacman packages vs Nix declarations
# Usage: check-drift [--fix]   (--fix prints the nix snippet to paste in)
#
# Goal: find packages you installed imperatively with pacman that aren't in
# your Home Manager config — so they won't survive a fresh setup.
set -euo pipefail

DOTFILES="${DOTFILES:-$HOME/.dotfiles}"
FIX="${1:-}"

# ── colors ─────────────────────────────────────────────────────────────────
RED=$'\033[31m' YEL=$'\033[33m' GRN=$'\033[32m' RST=$'\033[0m'

require_cmd() { command -v "$1" >/dev/null 2>&1 || { echo "${RED}missing: $1${RST}"; exit 1; }; }
require_cmd pacman

# ── gather Nix-declared package names ──────────────────────────────────────
# Extract bare names from all .nix files (heuristic: lines like `pkgname` or
# `pkgs.pkgname` inside packages = with pkgs; [...] blocks)
nix_pkgs=$(
  grep -rh '^\s\+[a-zA-Z0-9_-]\+\s*$\|pkgs\.[a-zA-Z0-9_.-]\+' \
    "$DOTFILES/nix" --include='*.nix' 2>/dev/null \
  | sed 's/.*pkgs\.\([a-zA-Z0-9_-]*\).*/\1/; s/^\s*//; s/\s*$//' \
  | sort -u
)

# ── gather explicitly installed pacman packages ────────────────────────────
# -Qe: explicitly installed; -Qen: native (not AUR); -Qem: AUR only
pacman_native=$(pacman -Qen 2>/dev/null | awk '{print $1}' | sort)
pacman_aur=$(pacman -Qem 2>/dev/null | awk '{print $1}' | sort)

# ── find drift: pacman packages not mentioned in any .nix file ─────────────
echo ""
echo "${YEL}==> Packages installed with pacman (native) not in Nix config:${RST}"
drift_native=$(comm -23 <(echo "$pacman_native") <(echo "$nix_pkgs") | grep -v '^$' || true)
if [[ -z "$drift_native" ]]; then
  echo "${GRN}  ✓ No drift in native packages${RST}"
else
  echo "$drift_native" | sed 's/^/  /'
fi

echo ""
echo "${YEL}==> AUR packages not in Nix config:${RST}"
drift_aur=$(comm -23 <(echo "$pacman_aur") <(echo "$nix_pkgs") | grep -v '^$' || true)
if [[ -z "$drift_aur" ]]; then
  echo "${GRN}  ✓ No drift in AUR packages${RST}"
else
  echo "$drift_aur" | sed 's/^/  /'
fi

# ── summary ────────────────────────────────────────────────────────────────
total_drift=$(printf '%s\n%s' "$drift_native" "$drift_aur" | grep -c '[a-z]' || true)
echo ""
if [[ "$total_drift" -eq 0 ]]; then
  echo "${GRN}✓ No drift — all explicit pacman packages are declared in Nix${RST}"
  exit 0
fi

echo "${RED}⚠ $total_drift package(s) not tracked in Nix. Run with --fix to see snippet.${RST}"

if [[ "$FIX" == "--fix" ]]; then
  echo ""
  echo "${YEL}# Paste into nix/modules/core/packages.nix or arch-desktop.nix:${RST}"
  printf '%s\n%s' "$drift_native" "$drift_aur" \
    | grep '[a-z]' \
    | sed 's/^/    # pacman-drift: /' \
    | sort -u
fi
