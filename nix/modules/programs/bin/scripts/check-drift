#!/usr/bin/env bash
# bin/check-drift — compare explicitly-installed pacman packages vs tracked ownership
# Usage: check-drift [--fix]
#
# Goal: find packages you installed imperatively with pacman that aren't
# declared anywhere in dotfiles ownership sources, so they won't survive a
# fresh setup.
set -euo pipefail

DOTFILES="${DOTFILES:-$HOME/.dotfiles}"
FIX="${1:-}"
PACMAN_MANIFEST_DIR="$DOTFILES/setup/arch/packages"
HM_PROGRAM_PKGS=$(printf '%s\n' git zsh tmux direnv)

# ── colors ─────────────────────────────────────────────────────────────────
RED=$'\033[31m' YEL=$'\033[33m' GRN=$'\033[32m' RST=$'\033[0m'

require_cmd() { command -v "$1" >/dev/null 2>&1 || { echo "${RED}missing: $1${RST}"; exit 1; }; }
require_cmd pacman

normalize_pkg_names() {
  sed \
    -e 's/^git-delta$/delta/'
}

# ── gather Nix-declared package names ──────────────────────────────────────
# Extract bare names from all .nix files (heuristic: lines like `pkgname` or
# `pkgs.pkgname` inside packages = with pkgs; [...] blocks)
nix_pkgs=$(
  grep -rh '^\s\+[a-zA-Z0-9_-]\+\s*$\|pkgs\.[a-zA-Z0-9_.-]\+' \
    "$DOTFILES/nix" --include='*.nix' 2>/dev/null \
  | sed 's/.*pkgs\.\([a-zA-Z0-9_-]*\).*/\1/; s/^\s*//; s/\s*$//' \
  | sort -u
)

pacman_manifest=$(
  if [[ -d "$PACMAN_MANIFEST_DIR" ]]; then
    grep -h -v '^#' "$PACMAN_MANIFEST_DIR"/*.txt 2>/dev/null | grep -v '^$' | awk '{print $1}' | sort -u
  fi
)

tracked_pkgs=$(printf '%s\n%s\n%s\n' "$nix_pkgs" "$pacman_manifest" "$HM_PROGRAM_PKGS" | grep -v '^$' | sort -u)

# ── gather explicitly installed pacman packages ────────────────────────────
# -Qe: explicitly installed; -Qen: native (not AUR); -Qem: AUR only
pacman_native=$(pacman -Qen 2>/dev/null | awk '{print $1}' | sort)
pacman_aur=$(pacman -Qem 2>/dev/null | awk '{print $1}' | sort)
pacman_native=$(echo "$pacman_native" | normalize_pkg_names | sort -u)
pacman_aur=$(echo "$pacman_aur" | normalize_pkg_names | sort -u)

# ── find drift: pacman packages not tracked anywhere in dotfiles ───────────
echo ""
echo "${YEL}==> Native pacman packages not tracked in Nix or setup/arch/packages/*.txt:${RST}"
drift_native=$(comm -23 <(echo "$pacman_native") <(echo "$tracked_pkgs") | grep -v '^$' || true)
if [[ -z "$drift_native" ]]; then
  echo "${GRN}  ✓ No drift in native packages${RST}"
else
  echo "$drift_native" | sed 's/^/  /'
fi

echo ""
echo "${YEL}==> AUR packages not tracked in Nix or setup/arch/packages/*.txt:${RST}"
drift_aur=$(comm -23 <(echo "$pacman_aur") <(echo "$tracked_pkgs") | grep -v '^$' || true)
if [[ -z "$drift_aur" ]]; then
  echo "${GRN}  ✓ No drift in AUR packages${RST}"
else
  echo "$drift_aur" | sed 's/^/  /'
fi

# ── summary ────────────────────────────────────────────────────────────────
total_drift=$(printf '%s\n%s' "$drift_native" "$drift_aur" | grep -c '[a-z]' || true)
echo ""
if [[ "$total_drift" -eq 0 ]]; then
  echo "${GRN}✓ No drift — all explicit pacman packages are tracked in dotfiles${RST}"
  exit 0
fi

echo "${RED}⚠ $total_drift package(s) not tracked in dotfiles. Run with --fix for notes.${RST}"

if [[ "$FIX" == "--fix" ]]; then
  echo ""
  echo "${YEL}# Decide ownership for each package:${RST}"
  echo "${YEL}#   - portable user tools/apps -> nix/modules/packages/*.nix${RST}"
  echo "${YEL}#   - system-integrated / desktop-stack apps -> setup/arch/packages/*.txt${RST}"
  printf '%s\n%s' "$drift_native" "$drift_aur" \
    | grep '[a-z]' \
    | sed 's/^/    # package-ownership: /' \
    | sort -u
fi
