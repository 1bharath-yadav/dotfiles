#!/usr/bin/env bash
# whisper-assistant: direct record-then-transcribe helper.
# Usage: whisper-assistant [seconds]

set -euo pipefail

QS_BIN="quickshell"
MODEL="${WHISPER_MODEL:-$HOME/linux/whisper_models/ggml-base-models/ggml-base.bin}"
SECONDS_TO_RECORD="${WHISPER_SECONDS:-${1:-5}}"
WAVFILE="${WHISPER_WAVFILE:-/tmp/whisper-assistant.wav}"

_ipc() { "$QS_BIN" -c ii ipc call voiceAssistant "$@" 2>/dev/null || true; }

_record() {
  rm -f "$WAVFILE"
  if command -v pw-record >/dev/null 2>&1; then
    timeout "${SECONDS_TO_RECORD}s" pw-record \
      --rate 16000 \
      --channels 1 \
      --format s16 \
      "$WAVFILE" >/tmp/whisper-assistant-pw-record.log 2>&1 || true
  else
    timeout "${SECONDS_TO_RECORD}s" ffmpeg -y \
      -f pulse -i default \
      -ac 1 -ar 16000 -c:a pcm_s16le \
      "$WAVFILE" >/tmp/whisper-assistant-ffmpeg.log 2>&1 || true
  fi
}

_transcribe() {
  local buf=""
  while IFS= read -r line; do
    line="${line//$'\r'/}"
    line="${line#"${line%%[![:space:]]*}"}"
    [[ -z "$line" ]] && continue
    if [[ "$line" == *"]"* ]]; then
      line="${line#*]}"
    fi
    line="${line#"${line%%[![:space:]]*}"}"
    [[ -z "$line" ]] && continue
    [[ -n "$buf" ]] && buf+=" "
    buf+="$line"
  done < <(whisper-cli \
    -m "$MODEL" \
    -f "$WAVFILE" \
    -nt -np \
    --beam-size 1 \
    --ov-e-device GPU \
    2>/dev/null) || true
  printf '%s' "$buf"
}

main() {
  _ipc status listening
  _record
  _ipc status thinking

  if [[ ! -s "$WAVFILE" ]]; then
    _ipc status ready
    exit 0
  fi

  if ! command -v whisper-cli >/dev/null 2>&1; then
    _ipc status error
    exit 1
  fi

  local text
  text="$(_transcribe)"
  if [[ -n "${text// }" ]]; then
    _ipc transcript "$text"
  fi
  _ipc status ready
}

main "$@"
