#!/usr/bin/env bash
# show-schedule — display today's study schedule via zenity
# reads ~/sarthak_spaces/AI_DS/schedule.json
# keybind: Super+/ (set in hyprland custom keybinds)

SCHEDULE_FILE="$HOME/sarthak_spaces/AI_DS/schedule.json"

if [[ ! -f "$SCHEDULE_FILE" ]]; then
  zenity --error --title="Schedule" --text="schedule.json not found at:\n$SCHEDULE_FILE" --width=340
  exit 1
fi

TODAY=$(date +%Y-%m-%d)
NOW=$(date +%H:%M)

DAY_DATA=$(python3 - <<PYEOF
import json, sys

with open("$SCHEDULE_FILE") as f:
    data = json.load(f)

today = "$TODAY"
now = "$NOW"

day = next((d for d in data["days"] if d["date"] == today), None)
if not day:
    print("NO_DAY")
    sys.exit(0)

print(f"DAY:{day['day']} — {day['theme']}")
print(f"WEEK:{data['week']}")

current_block = None
next_block = None
for b in day["blocks"]:
    if b["time"] <= now:
        current_block = b
    elif next_block is None:
        next_block = b

if current_block:
    print(f"CURRENT:{current_block['time']} [{current_block['tag']}] {current_block['task']}")
if next_block:
    print(f"NEXT:{next_block['time']} [{next_block['tag']}] {next_block['task']}")

for b in day["blocks"]:
    marker = "▶" if b == current_block else " "
    print(f"BLOCK:{marker} {b['time']} ({b['dur']}) [{b['tag']}]  {b['task']}")
PYEOF
)

if [[ "$DAY_DATA" == "NO_DAY" ]]; then
  zenity --info --title="No Schedule Today" \
    --text="No schedule for $TODAY.\nWeek ends Apr 4 (OPPE1 day)." \
    --width=340
  exit 0
fi

DAY_LINE=$(echo "$DAY_DATA" | grep '^DAY:' | sed 's/^DAY://')
WEEK_LINE=$(echo "$DAY_DATA" | grep '^WEEK:' | sed 's/^WEEK://')
CURRENT_LINE=$(echo "$DAY_DATA" | grep '^CURRENT:' | sed 's/^CURRENT://')
NEXT_LINE=$(echo "$DAY_DATA" | grep '^NEXT:' | sed 's/^NEXT://')

ZENITY_ROWS=()
while IFS= read -r line; do
  if [[ "$line" == BLOCK:* ]]; then
    block="${line#BLOCK:}"
    col1=$(echo "$block" | grep -oP '^.+?\]')
    col2=$(echo "$block" | sed 's/^.*\]  //')
    ZENITY_ROWS+=("$col1" "$col2")
  fi
done <<< "$DAY_DATA"

zenity --list \
  --title="📅 ${DAY_LINE}" \
  --text="<b>${WEEK_LINE}</b>\n⏰ Now: ${NOW}\n\n<b>Current:</b> ${CURRENT_LINE:-—}\n<b>Next up:</b> ${NEXT_LINE:-—}" \
  --column="Time / Tag" \
  --column="Task" \
  --width=780 --height=540 \
  "${ZENITY_ROWS[@]}" 2>/dev/null

exit 0
