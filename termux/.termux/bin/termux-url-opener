#!/bin/sh
# ~/.termux/bin/termux-url-opener
URL="$1"
mkdir -p ~/youtube-downloads ~/instagram-downloads

if echo "$URL" | grep -q "instagram.com"; then
  instaloader --dirname-pattern ~/instagram-downloads \
    --filename-pattern '{profile}_{date_utc}_{shortcode}' -- "$URL"
else
  yt-dlp -o "~/youtube-downloads/%(title)s.%(ext)s" "$URL"
fi
