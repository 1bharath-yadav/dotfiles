--target=~
--verbose=1
--no-folding

# ── File-name ignores (apply inside every package) ─────────────────────────
# Stow meta
--ignore='\.stowrc$'
--ignore='\.gitignore$'
--ignore='\.gitkeep$'
--ignore='^\.git$'

# Repo meta-files (safety net if someone calls stow . accidentally)
--ignore='^README\.md$'
--ignore='^Setup\.md$'
--ignore='^AGENTS\.md$'
--ignore='^pkgs\.json$'
--ignore='^pkgs\.json\.bak$'
--ignore='^update\.sh$'
--ignore='^update\.log$'

# Non-package top-level dirs — ignored by name so `stow .` can never stow them
--ignore='^setup$'
--ignore='^stow$'
--ignore='^shell-sources$'

# Workspace / spaces meta
--ignore='\.sarthak_workspace\.json$'
--ignore='\.spaces\.json$'
--ignore='^\.spaces$'

# Old termux nested remnants inside termux/ package
--ignore='^termux$'
--ignore='^zsh$'
--ignore='^setup\.sh$'

# Yazi — plugins and flavors are managed by `ya pkg`, never stowed
--ignore='^plugins$'
--ignore='^flavors$'
