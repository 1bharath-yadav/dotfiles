#!/usr/bin/env bash

set -eu

# ----------------------------
# CONFIG
# ----------------------------

REPO_PATH="."
DRY_RUN=false
MAX_DIFF_LINES=180
TMP=$(mktemp)

trap 'rm -f "$TMP"' EXIT

PROVIDERS=("copilot" "gemini" "ollama")

# ----------------------------
# ARGS
# ----------------------------

while [[ $# -gt 0 ]]; do
  case "$1" in
    --dry-run) DRY_RUN=true; shift ;;
    *) REPO_PATH="$1"; shift ;;
  esac
done

cd "$REPO_PATH"

git rev-parse --git-dir >/dev/null 2>&1 || {
  echo "Not a git repository"
  exit 1
}

git add -A

if git diff --cached --quiet; then
  echo "Nothing staged"
  exit 1
fi

# ----------------------------
# DIFF COLLECTION (FAST)
# ----------------------------

STAT=$(git diff --cached --stat)
DIFF=$(git diff --cached --unified=0 | head -n "$MAX_DIFF_LINES")

# ----------------------------
# PROMPT
# ----------------------------

PROMPT=$(cat <<EOF
Generate a Conventional Commit message.

Format:
type(scope): short summary (<72 chars)

- bullet explaining change
- bullet explaining change

Git diff summary:
$STAT

Diff snippet:
$DIFF
EOF
)

# ----------------------------
# PROVIDER FUNCTIONS
# ----------------------------

run_copilot() {
  if command -v gh >/dev/null 2>&1; then
    gh copilot -p "$PROMPT" > "$TMP" 2>/dev/null && return 0
  fi
  return 1
}

run_gemini() {
  if command -v gemini >/dev/null 2>&1; then
    echo "$PROMPT" | gemini -m gemini-2.5-pro -p "" > "$TMP" 2>/dev/null && return 0
  fi
  return 1
}

run_ollama() {
  if command -v ollama >/dev/null 2>&1; then
    echo "$PROMPT" | ollama run granite3:latest > "$TMP" 2>/dev/null && return 0
  fi
  return 1
}

# ----------------------------
# FALLBACK EXECUTION
# ----------------------------

SUCCESS=false

for provider in "${PROVIDERS[@]}"; do
  echo "→ trying $provider..."

  if "run_$provider"; then
    SUCCESS=true
    echo "✓ used $provider"
    break
  else
    echo "⚠ $provider failed"
  fi
done

if ! $SUCCESS; then
  echo "All AI providers failed"
  exit 1
fi

# ----------------------------
# CLEAN OUTPUT
# ----------------------------

MSG=$(sed '/^```/d' "$TMP")

# ----------------------------
# DELTA PREVIEW
# ----------------------------

echo
echo "──────── AI Commit Preview ────────"
echo

if command -v delta >/dev/null 2>&1; then
  printf "%s\n" "$MSG" | delta
else
  printf "%s\n" "$MSG"
fi

echo
echo "───────────────────────────────────"
echo

# ----------------------------
# INTERACTIVE APPROVAL
# ----------------------------

read -r -p "Commit with this message? [y/N/e]: " RESP

case "$RESP" in
  y|Y)
    if ! $DRY_RUN; then
      git commit -m "$MSG"
    fi
  ;;
  e|E)
    ${EDITOR:-nvim} "$TMP"
    NEW_MSG=$(cat "$TMP")
    git commit -m "$NEW_MSG"
  ;;
  *)
    echo "Commit cancelled."
  ;;
esac
