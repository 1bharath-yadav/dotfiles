#!/usr/bin/env bash
# aicommit — generate a Conventional Commit message via AI provider
# Usage: aicommit [provider]
#   providers: copilot | codex | gemini | ollama  (default: copilot)
# After generation, prompts: [e]dit  [p]ush  [c]ancel
# Used standalone; lazygit customCommands call it in a terminal pane.

MAX_DIFF=300
PROVIDER=""

# ── Argument parsing ──────────────────────────────────────────────────────
for arg in "$@"; do
  case "$arg" in
    ""|.) ;;
    *) PROVIDER="$arg" ;;
  esac
done
PROVIDER="${PROVIDER:-copilot}"

# ── Guard: must be in a git repo with staged changes ──────────────────────
if ! git rev-parse --git-dir >/dev/null 2>&1; then
  echo "ERROR: not a git repository" >&2; exit 1
fi

STAT=$(git diff --cached --stat)
if [[ -z "$STAT" ]]; then
  echo "ERROR: nothing staged — run 'git add' first" >&2; exit 1
fi

DIFF=$(git diff --cached --unified=2 | head -n "$MAX_DIFF")

# ── Prompt ────────────────────────────────────────────────────────────────
PROMPT="Write a git commit message in Conventional Commits format.
Rules:
- First line: type(scope): summary (<=72 chars, imperative, no period)
  Types: feat fix refactor perf style test docs chore build ci revert
- Blank line, then 2-5 bullet points (- ) explaining WHAT changed and WHY.
  Name specific files/functions where helpful.
- If breaking change: add footer  BREAKING CHANGE: <reason>
- Output the commit message ONLY. No fences, no preamble, no commentary.

STAT:
${STAT}

DIFF:
${DIFF}"

# ── Provider dispatch ─────────────────────────────────────────────────────
LOG="/tmp/aicommit-${PROVIDER}-$$.log"

case "$PROVIDER" in
  copilot)
    output=$(printf "%s" "$PROMPT" | opencode run --model github-copilot/gpt-4.1 --format json 2>"$LOG" \
      | jq -r 'select(.type=="text") | .part.text')
    rc=${PIPESTATUS[1]}
    ;;
  codex)
    output=$(codex exec --ephemeral "$PROMPT" 2>"$LOG"); rc=$?
    ;;
  gemini)
    output=$(gemini --prompt "$PROMPT" 2>"$LOG"); rc=$?
    ;;
  ollama)
    output=$(printf "%s" "$PROMPT" | ollama run "${OLLAMA_COMMIT_MODEL:-granite3.3:latest}" 2>"$LOG"); rc=$?
    ;;
  *)
    echo "ERROR: unknown provider '$PROVIDER'" >&2; exit 1
    ;;
esac

if [[ ${rc:-$?} -ne 0 ]]; then
  echo "ERROR: $PROVIDER failed — see $LOG" >&2; cat "$LOG" >&2; exit 1
fi

# ── Cleanup model output ──────────────────────────────────────────────────
cleaned=$(printf "%s\n" "$output" \
  | sed '/^```/d;/^---/d;s/^[[:space:]]*//' \
  | awk 'NF || !blank++' \
  | head -n 20)

# ── Show message + interactive prompt ─────────────────────────────────────
tmpfile=$(mktemp /tmp/aicommit-edit-XXXXXX.txt)
printf "%s\n" "$cleaned" >"$tmpfile"

while true; do
  printf "\n\033[1;34m── Generated commit message ──\033[0m\n" >/dev/tty
  printf "%s\n" "$cleaned" >/dev/tty
  printf "\n\033[1;33m[e]dit  [p]ush  [c]ancel\033[0m  > " >/dev/tty
  read -r choice </dev/tty

  case "$choice" in
    e|E)
      ${EDITOR:-nvim} "$tmpfile" </dev/tty >/dev/tty
      cleaned=$(cat "$tmpfile")
      ;;
    p|P)
      git commit -m "$cleaned"
      break
      ;;
    c|C|"")
      echo "Cancelled." >/dev/tty
      rm -f "$tmpfile"
      exit 0
      ;;
    *)
      echo "Press e, p, or c." >/dev/tty
      ;;
  esac
done

rm -f "$tmpfile"
