#!/usr/bin/env bash
# aicommit — generate a Conventional Commit message via AI provider
# Usage: aicommit [provider]
#   providers: copilot | gemini | codex | ollama  (default: copilot)
# Used by lazygit customCommands; lazygit handles approval/editing.
set -euo pipefail

MAX_DIFF=300
PROVIDER="${1:-copilot}"

# ── Guard: must be in a git repo with staged changes ──────────────────────
if ! git rev-parse --git-dir >/dev/null 2>&1; then
  echo "ERROR: not a git repository" >&2; exit 1
fi

STAT=$(git diff --cached --stat)
DIFF=$(git diff --cached --unified=2 | head -n "$MAX_DIFF")

if [[ -z "$STAT" ]]; then
  echo "ERROR: nothing staged — run 'git add' first" >&2; exit 1
fi

# ── Prompt ────────────────────────────────────────────────────────────────
PROMPT="Write a git commit message in Conventional Commits format.
Rules:
- First line: type(scope): summary (<=72 chars, imperative, no period)
  Types: feat fix refactor perf style test docs chore build ci revert
- Blank line, then 2-5 bullet points (- ) explaining WHAT changed and WHY.
  Name specific files/functions where helpful.
- If breaking change: add footer  BREAKING CHANGE: <reason>
- Output the commit message ONLY. No fences, no preamble, no commentary.

STAT:
${STAT}

DIFF:
${DIFF}"

# ── Dispatch ──────────────────────────────────────────────────────────────
_run_provider() {
  case "$PROVIDER" in
    copilot)
      command -v gh >/dev/null 2>&1 || { echo "ERROR: gh not found" >&2; exit 1; }
      gh copilot suggest -t shell "$PROMPT" 2>/dev/null \
        || gh copilot -p "$PROMPT" 2>/dev/null
      ;;
    gemini)
      command -v gemini >/dev/null 2>&1 || { echo "ERROR: gemini CLI not found" >&2; exit 1; }
      echo "$PROMPT" | gemini --model gemini-2.5-pro -p ""
      ;;
    codex)
      command -v codex >/dev/null 2>&1 || { echo "ERROR: codex not found" >&2; exit 1; }
      # Write prompt to temp file; capture output explicitly
      local tmpfile; tmpfile=$(mktemp /tmp/aicommit-codex-XXXXXX.txt)
      echo "$PROMPT" > "$tmpfile"
      codex exec --ephemeral --sandbox read-only "$(cat "$tmpfile")" -o /dev/stdout
      rm -f "$tmpfile"
      ;;
    ollama)
      command -v ollama >/dev/null 2>&1 || { echo "ERROR: ollama not found" >&2; exit 1; }
      local model="${OLLAMA_COMMIT_MODEL:-granite3.3:latest}"
      echo "$PROMPT" | ollama run "$model"
      ;;
    *)
      echo "ERROR: unknown provider '$PROVIDER'" >&2
      echo "       valid: copilot | gemini | codex | ollama" >&2
      exit 1
      ;;
  esac
}

# ── Run + clean output ────────────────────────────────────────────────────
_run_provider \
  | sed '/^```/d; /^---/d; s/^[[:space:]]*//' \
  | sed '/^$/{ N; /^\n$/d }' \
  | head -n 20
