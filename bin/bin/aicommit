#!/usr/bin/env bash
# aicommit — generate a Conventional Commit message via AI provider
# Usage: aicommit [provider]
#   providers: copilot | gemini | codex | ollama  (default: copilot)
# Used by lazygit customCommands; lazygit handles approval/editing.
set -euo pipefail
set -x
MAX_DIFF=300
PROVIDER="${1:-copilot}"

# If first argument is a path like "." treat it as repo path not provider
if [[ "$PROVIDER" == "." || -d "$PROVIDER" ]]; then
  PROVIDER="gemini"
fi

# ── Guard: must be in a git repo with staged changes ──────────────────────
if ! git rev-parse --git-dir >/dev/null 2>&1; then
  echo "ERROR: not a git repository" >&2; exit 1
fi

STAT=$(git diff --cached --stat)
DIFF=$(git diff --cached --unified=2 | head -n "$MAX_DIFF")

if [[ -z "$STAT" ]]; then
  echo "ERROR: nothing staged — run 'git add' first" >&2; exit 1
fi

# ── Prompt ────────────────────────────────────────────────────────────────
PROMPT="Write a git commit message in Conventional Commits format.
Rules:
- First line: type(scope): summary (<=72 chars, imperative, no period)
  Types: feat fix refactor perf style test docs chore build ci revert
- Blank line, then 2-5 bullet points (- ) explaining WHAT changed and WHY.
  Name specific files/functions where helpful.
- If breaking change: add footer  BREAKING CHANGE: <reason>
- Output the commit message ONLY. No fences, no preamble, no commentary.

STAT:
${STAT}

DIFF:
${DIFF}"

# ── Dispatch ──────────────────────────────────────────────────────────────
__run_provider() {
  case "$PROVIDER" in
    copilot)
      command -v gh >/dev/null || { echo "ERROR: gh not found" >&2; exit 1; }
      gh copilot suggest "$PROMPT" --shell 2>/dev/null \
        || gh copilot suggest "$PROMPT"
      ;;

    gemini)
      command -v gemini >/dev/null || { echo "ERROR: gemini CLI not found" >&2; exit 1; }
      printf "%s" "$PROMPT" | gemini --model gemini-2.5-pro
      ;;

    codex)
      command -v codex >/dev/null || { echo "ERROR: codex not found" >&2; exit 1; }
      local tmpfile
      tmpfile=$(mktemp /tmp/aicommit-codex-XXXXXX.txt)
      printf "%s" "$PROMPT" > "$tmpfile"
      codex exec --ephemeral "$(cat "$tmpfile")"
      rm -f "$tmpfile"
      ;;

    ollama)
      command -v ollama >/dev/null || { echo "ERROR: ollama not found" >&2; exit 1; }
      local model="${OLLAMA_COMMIT_MODEL:-granite3.3:latest}"
      printf "%s" "$PROMPT" | ollama run "$model"
      ;;
  esac
}
# ── Run + clean output ────────────────────────────────────────────────────

output="$(_run_provider)"

printf "%s\n" "$output" \
  | sed '/^```/d;/^---/d;s/^[[:space:]]*//' \
  | awk 'NF || !blank++' \
  | head -n 20
